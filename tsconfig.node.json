{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/content/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "resolveJsonModule": true,
    "types": ["node", "electron-vite/node"],
    "noImplicitAny": true
  }
}
